NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key_here

# Service-role key (same Supabase project as the time-app). Server-only.
# Required for auto-creating time-app draft shifts when a deal is booked.
# Without it, that feature fails closed and no shifts are created.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Personal-finance pages (/money, /dial, /safe) ---
# Feed source, checked in this order. If neither is set the pages render a
# "feed not wired yet" empty state.
#
# Dev: absolute path to a local pf_data.json (e.g. the synthetic fixture):
# PF_DATA_PATH=./fixtures/pf_data.sample.json
#
# Prod (Vercel): fine-grained GitHub PAT, contents:read on the private
# personal-finance data repo ONLY. Server-only — never expose client-side.
# PF_GITHUB_TOKEN=github_pat_xxx
